@page
@model ClinicManagement.Web.Pages.Admin.AdminHomeModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
        <hr />
    </div>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Total Doctors</h6>
                        <h2 class="mb-0">@Model.Dashboard.TotalDoctors</h2>
                    </div>
                    <i class="fas fa-user-md fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Total Patients</h6>
                        <h2 class="mb-0">@Model.Dashboard.TotalPatients</h2>
                    </div>
                    <i class="fas fa-users fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Total Income</h6>
                        <h2 class="mb-0">$@Model.Dashboard.TotalIncome.ToString("N2")</h2>
                    </div>
                    <i class="fas fa-dollar-sign fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Navigation -->
<div class="row mb-4">
    <div class="col-12">
        <div class="btn-group" role="group">
            <a asp-page="/Admin/ManageClinic" class="btn btn-outline-primary">
                <i class="fas fa-clinic-medical me-1"></i>Manage Clinic
            </a>
            <a asp-page="/Admin/DoctorRegistrationForm" class="btn btn-outline-success">
                <i class="fas fa-user-md me-1"></i>Register Doctor
            </a>
            <a asp-page="/Admin/AddStaff" class="btn btn-outline-info">
                <i class="fas fa-user-plus me-1"></i>Add Staff
            </a>
            <a asp-page="/Index" class="btn btn-outline-danger">
                <i class="fas fa-sign-out-alt me-1"></i>Logout
            </a>
        </div>
    </div>
</div>

<!-- Departments Table -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-building me-2"></i>Departments</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Department</th>
                                <th>Doctors</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model.Dashboard.Departments)
                            {
                                <tr>
                                    <td>@dept.DeptName</td>
                                    <td>@dept.DoctorCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Appointments -->
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-calendar-check me-2"></i>Recent Appointments</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Doctor</th>
                                <th>Patient</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.Dashboard.RecentAppointments)
                            {
                                <tr>
                                    <td>@appt.DoctorName</td>
                                    <td>@appt.PatientName</td>
                                    <td>
                                        <span class="badge @(appt.Status == "Approved" ? "bg-success" : appt.Status == "Pending" ? "bg-warning" : "bg-secondary")">
                                            @appt.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
