@page
@model ClinicManagement.Web.Pages.Admin.ManageClinicModel
@{
    ViewData["Title"] = "Manage Clinic";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-clinic-medical me-2"></i>Manage Clinic</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">@Model.Message</div>
}

<!-- Filter Controls -->
<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <select name="category" class="form-select" onchange="this.form.submit()">
                    <option value="DOCTOR" @(Model.Category == "DOCTOR" ? "selected" : "")>Doctors</option>
                    <option value="PATIENT" @(Model.Category == "PATIENT" ? "selected" : "")>Patients</option>
                    <option value="OTHERSTAFF" @(Model.Category == "OTHERSTAFF" ? "selected" : "")>Other Staff</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Search</label>
                <input type="text" name="search" class="form-control" value="@Model.SearchQuery" placeholder="Search by name..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i>Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Data Table -->
<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">@Model.Category Records</h5>
    </div>
    <div class="card-body">
        @if (Model.Category == "DOCTOR")
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doctor in Model.Doctors)
                        {
                            <tr>
                                <td>@doctor.DoctorId</td>
                                <td>@doctor.Name</td>
                                <td>@doctor.DeptName</td>
                                <td>@doctor.Email</td>
                                <td>@doctor.Phone</td>
                                <td>
                                    <form method="post" asp-page-handler="DeleteDoctor" class="d-inline">
                                        <input type="hidden" name="id" value="@doctor.DoctorId" />
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this doctor?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.Category == "PATIENT")
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Gender</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model.Patients)
                        {
                            <tr>
                                <td>@patient.PatientId</td>
                                <td>@patient.Name</td>
                                <td>@patient.Phone</td>
                                <td>@patient.Email</td>
                                <td>@patient.Gender</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Designation</th>
                            <th>Phone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var staff in Model.Staff)
                        {
                            <tr>
                                <td>@staff.StaffId</td>
                                <td>@staff.Name</td>
                                <td>@staff.Designation</td>
                                <td>@staff.Phone</td>
                                <td>
                                    <form method="post" asp-page-handler="DeleteStaff" class="d-inline">
                                        <input type="hidden" name="id" value="@staff.StaffId" />
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this staff member?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-page="/Admin/AdminHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>
