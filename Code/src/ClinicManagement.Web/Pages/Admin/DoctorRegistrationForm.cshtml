@page
@model ClinicManagement.Web.Pages.Admin.DoctorRegistrationFormModel
@{
    ViewData["Title"] = "Register Doctor";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-user-md me-2"></i>Doctor Registration</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">@Model.Message</div>
}

<div class="card shadow">
    <div class="card-body">
        <form method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Full Name *</label>
                    <input type="text" name="Name" class="form-control" value="@Model.Input.Name" required maxlength="30" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Email *</label>
                    <input type="email" name="Email" class="form-control" value="@Model.Input.Email" required maxlength="30" />
                    @if (!string.IsNullOrEmpty(Model.EmailError))
                    {
                        <div class="text-danger small">@Model.EmailError</div>
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Password *</label>
                    <input type="password" name="Password" class="form-control" required maxlength="30" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Date of Birth *</label>
                    <input type="date" name="BirthDate" class="form-control" value="@Model.Input.BirthDate" required />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Department *</label>
                    <select name="DeptNo" class="form-select" required>
                        <option value="0">Select Department</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.DeptNo" @(Model.Input.DeptNo == dept.DeptNo ? "selected" : "")>@dept.DeptName</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Gender *</label>
                    <select name="Gender" class="form-select" required>
                        <option value="">Select Gender</option>
                        <option value="M" @(Model.Input.Gender == "M" ? "selected" : "")>Male</option>
                        <option value="F" @(Model.Input.Gender == "F" ? "selected" : "")>Female</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone *</label>
                    <input type="tel" name="Phone" class="form-control" value="@Model.Input.Phone" required maxlength="30" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Address *</label>
                    <input type="text" name="Address" class="form-control" value="@Model.Input.Address" required maxlength="30" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Experience (years) *</label>
                    <input type="number" name="Experience" class="form-control" value="@Model.Input.Experience" required min="0" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Salary *</label>
                    <input type="number" name="Salary" class="form-control" value="@Model.Input.Salary" required min="0" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Charges Per Visit *</label>
                    <input type="number" name="ChargesPerVisit" class="form-control" value="@Model.Input.ChargesPerVisit" required min="0" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Specialization *</label>
                    <input type="text" name="Specialization" class="form-control" value="@Model.Input.Specialization" required maxlength="30" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Qualification *</label>
                    <input type="text" name="Qualification" class="form-control" value="@Model.Input.Qualification" required maxlength="30" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save me-1"></i>Register Doctor
                </button>
                <a asp-page="/Admin/AdminHome" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Back to Dashboard
                </a>
            </div>
        </form>
    </div>
</div>
