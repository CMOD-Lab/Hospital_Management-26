@page
@model ClinicManagement.Web.Pages.Patient.AppointmentRequestSentModel
@{
    ViewData["Title"] = "Appointment Request Sent";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow">
            <div class="card-body py-5">
                <i class="fas fa-check-circle fa-5x text-success mb-4"></i>
                <h3>Appointment Request Sent!</h3>
                <p class="text-muted">Your appointment request has been submitted successfully. Please wait for the doctor to approve it.</p>
                <div class="mt-4">
                    <a asp-page="/Patient/PatientHome" class="btn btn-primary me-2">
                        <i class="fas fa-home me-1"></i>Go to Home
                    </a>
                    <a asp-page="/Patient/PatientNotifications" class="btn btn-info">
                        <i class="fas fa-bell me-1"></i>Check Notifications
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
