@page
@model ClinicManagement.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-file-invoice me-2"></i>Bills History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.Bills.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Bill ID</th>
                            <th>Doctor</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in Model.Bills)
                        {
                            <tr>
                                <td>@bill.BillId</td>
                                <td>@bill.DoctorName</td>
                                <td>$@bill.Amount.ToString("N2")</td>
                                <td>@bill.BillDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge @(bill.IsPaid ? "bg-success" : "bg-warning")">
                                        @(bill.IsPaid ? "Paid" : "Pending")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">No bills found.</div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-page="/Patient/PatientHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Home
    </a>
</div>
