@page
@model ClinicManagement.Web.Pages.Patient.ViewDoctorsModel
@{
    ViewData["Title"] = "View Doctors";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-user-md me-2"></i>View Doctors</h2>
        <hr />
    </div>
</div>

<!-- Department Filter -->
<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Filter by Department</label>
                <select name="deptName" class="form-select" onchange="this.form.submit()">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.DeptName" selected="@(Model.SelectedDept == dept.DeptName)">@dept.DeptName</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<div class="row">
    @foreach (var doctor in Model.Doctors)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="fas fa-user-md fa-3x text-primary mb-3"></i>
                    <h5>@doctor.Name</h5>
                    <p class="text-muted">@doctor.DeptName</p>
                    <p><strong>Specialization:</strong> @doctor.Specialization</p>
                    <p><strong>Charges:</strong> $@doctor.ChargesPerVisit/visit</p>
                    <p><strong>Experience:</strong> @doctor.Experience years</p>
                    <a asp-page="/Patient/DoctorProfile" asp-route-doctorId="@doctor.DoctorId" class="btn btn-primary btn-sm">
                        <i class="fas fa-eye me-1"></i>View Profile
                    </a>
                    <a asp-page="/Patient/AppointmentTaker" asp-route-doctorId="@doctor.DoctorId" class="btn btn-success btn-sm">
                        <i class="fas fa-calendar-plus me-1"></i>Book Appointment
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Doctors.Any())
{
    <div class="alert alert-info">No doctors found.</div>
}

<div class="mt-3">
    <a asp-page="/Patient/PatientHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Home
    </a>
</div>
