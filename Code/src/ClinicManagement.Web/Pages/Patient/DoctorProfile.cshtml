@page "{doctorId:int}"
@model ClinicManagement.Web.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-user-md me-2"></i>Doctor Profile</h2>
        <hr />
    </div>
</div>

@if (Model.Doctor != null)
{
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow text-center">
                <div class="card-body py-4">
                    <i class="fas fa-user-md fa-5x text-primary mb-3"></i>
                    <h4>@Model.Doctor.Name</h4>
                    <p class="text-muted">@Model.Doctor.Specialization</p>
                    <div class="d-flex justify-content-center gap-1">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="fas fa-star @(i <= Model.Doctor.ReputeIndex ? "text-warning" : "text-muted")"></i>
                        }
                    </div>
                    <p class="mt-2">Repute Index: @Model.Doctor.ReputeIndex.ToString("F1")</p>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Professional Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Phone:</strong> @Model.Doctor.Phone</p>
                            <p><strong>Gender:</strong> @Model.Doctor.Gender</p>
                            <p><strong>Age:</strong> @Model.Doctor.Age years</p>
                            <p><strong>Department:</strong> @Model.Doctor.DeptName</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Experience:</strong> @Model.Doctor.Experience years</p>
                            <p><strong>Qualification:</strong> @Model.Doctor.Qualification</p>
                            <p><strong>Charges/Visit:</strong> $@Model.Doctor.ChargesPerVisit</p>
                            <p><strong>Patients Treated:</strong> @Model.Doctor.PatientsTreated</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <a asp-page="/Patient/AppointmentTaker" asp-route-doctorId="@Model.Doctor.DoctorId" class="btn btn-success">
                    <i class="fas fa-calendar-plus me-1"></i>Book Appointment
                </a>
                <a asp-page="/Patient/ViewDoctors" class="btn btn-secondary ms-2">
                    <i class="fas fa-arrow-left me-1"></i>Back
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">Doctor not found.</div>
    <a asp-page="/Patient/ViewDoctors" class="btn btn-secondary">Back</a>
}
