@page
@model ClinicManagement.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-star me-2"></i>Patient Feedback</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-info")">@Model.Message</div>
}

@if (Model.PendingFeedback != null)
{
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">Pending Feedback</h5>
        </div>
        <div class="card-body">
            <p><strong>Doctor:</strong> @Model.PendingFeedback.DoctorName</p>
            <p><strong>Appointment Date:</strong> @Model.PendingFeedback.AppointmentDate.ToString("yyyy-MM-dd")</p>
            <p><strong>Timings:</strong> @Model.PendingFeedback.Timings</p>
            <form method="post">
                <input type="hidden" name="appointmentId" value="@Model.PendingFeedback.AppointmentId" />
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-star me-1"></i>Submit Feedback
                </button>
            </form>
        </div>
    </div>
}
else if (string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No pending feedback at this time.
    </div>
}

<div class="mt-3">
    <a asp-page="/Patient/PatientHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Home
    </a>
</div>
