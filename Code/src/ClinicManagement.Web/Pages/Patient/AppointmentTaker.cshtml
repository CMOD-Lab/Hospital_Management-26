@page "{doctorId:int}"
@model ClinicManagement.Web.Pages.Patient.AppointmentTakerModel
@{
    ViewData["Title"] = "Take Appointment";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-calendar-plus me-2"></i>Take Appointment</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">@Model.Message</div>
}

@if (Model.Doctor != null)
{
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Doctor: @Model.Doctor.Name - @Model.Doctor.DeptName</h5>
        </div>
        <div class="card-body">
            <p><strong>Specialization:</strong> @Model.Doctor.Specialization</p>
            <p><strong>Charges per Visit:</strong> $@Model.Doctor.ChargesPerVisit</p>
        </div>
    </div>

    @if (Model.FreeSlots.Any())
    {
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Available Slots</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" name="doctorId" value="@Model.Doctor.DoctorId" />
                    <div class="row">
                        @foreach (var slot in Model.FreeSlots)
                        {
                            <div class="col-md-3 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="freeSlot" value="@slot" id="slot@slot" required />
                                    <label class="form-check-label" for="slot@slot">
                                        Slot @slot
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-calendar-check me-1"></i>Book Appointment
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">No free slots available for this doctor today.</div>
    }
}

<div class="mt-3">
    <a asp-page="/Patient/ViewDoctors" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Doctors
    </a>
</div>
