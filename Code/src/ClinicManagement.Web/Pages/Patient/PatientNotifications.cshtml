@page
@model ClinicManagement.Web.Pages.Patient.PatientNotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-bell me-2"></i>Notifications</h2>
        <hr />
    </div>
</div>

@if (Model.Notifications.Any())
{
    @foreach (var notif in Model.Notifications)
    {
        <div class="card shadow mb-3 border-success">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-check-circle text-success me-2"></i>Appointment Approved</h5>
                <p><strong>Doctor:</strong> @notif.DoctorName</p>
                <p><strong>Timings:</strong> @notif.Timings</p>
                <p><strong>Date:</strong> @notif.AppointmentDate.ToString("yyyy-MM-dd")</p>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No notifications at this time.
    </div>
}

<div class="mt-3">
    <a asp-page="/Patient/PatientHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Home
    </a>
</div>
