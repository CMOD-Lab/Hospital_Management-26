@page
@model ClinicManagement.Web.Pages.Patient.CurrentAppointmentModel
@{
    ViewData["Title"] = "Current Appointment";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-calendar-check me-2"></i>Current Appointment</h2>
        <hr />
    </div>
</div>

@if (Model.Appointment != null)
{
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Today's Appointment Details</h5>
        </div>
        <div class="card-body">
            <p><strong>Doctor:</strong> @Model.Appointment.DoctorName</p>
            <p><strong>Timings:</strong> @Model.Appointment.Timings</p>
            <p><strong>Slot:</strong> @Model.Appointment.FreeSlot</p>
            <p><strong>Status:</strong> <span class="badge bg-success">@Model.Appointment.Status</span></p>
            <p><strong>Date:</strong> @Model.Appointment.AppointmentDate.ToString("yyyy-MM-dd")</p>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No current appointment for today.
    </div>
}

<div class="mt-3">
    <a asp-page="/Patient/PatientHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Home
    </a>
</div>
