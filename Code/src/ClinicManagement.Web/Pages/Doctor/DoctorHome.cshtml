@page
@model ClinicManagement.Web.Pages.Doctor.DoctorHomeModel
@{
    ViewData["Title"] = "Doctor Home";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-user-md me-2"></i>Doctor Profile</h2>
        <hr />
    </div>
</div>

@if (Model.Doctor != null)
{
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow text-center">
                <div class="card-body py-4">
                    <i class="fas fa-user-md fa-5x text-primary mb-3"></i>
                    <h4>@Model.Doctor.Name</h4>
                    <p class="text-muted">@Model.Doctor.Specialization</p>
                    <span class="badge bg-success">Active</span>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Doctor Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Email:</strong> @Model.Doctor.Email</p>
                            <p><strong>Phone:</strong> @Model.Doctor.Phone</p>
                            <p><strong>Gender:</strong> @Model.Doctor.Gender</p>
                            <p><strong>Age:</strong> @Model.Doctor.Age years</p>
                            <p><strong>Address:</strong> @Model.Doctor.Address</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Department:</strong> @Model.Doctor.DeptName</p>
                            <p><strong>Experience:</strong> @Model.Doctor.Experience years</p>
                            <p><strong>Qualification:</strong> @Model.Doctor.Qualification</p>
                            <p><strong>Charges/Visit:</strong> $@Model.Doctor.ChargesPerVisit</p>
                            <p><strong>Repute Index:</strong> @Model.Doctor.ReputeIndex.ToString("F2")</p>
                            <p><strong>Patients Treated:</strong> @Model.Doctor.PatientsTreated</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-page="/Doctor/PendingAppointment" class="btn btn-warning">
                            <i class="fas fa-clock me-1"></i>Pending Appointments
                        </a>
                        <a asp-page="/Doctor/PatientHistory" class="btn btn-info">
                            <i class="fas fa-history me-1"></i>Patient History
                        </a>
                        <a asp-page="/Doctor/Bill" class="btn btn-success">
                            <i class="fas fa-file-invoice-dollar me-1"></i>Generate Bills
                        </a>
                        <a asp-page="/Index" class="btn btn-danger">
                            <i class="fas fa-sign-out-alt me-1"></i>Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">Error loading doctor information.</div>
}
