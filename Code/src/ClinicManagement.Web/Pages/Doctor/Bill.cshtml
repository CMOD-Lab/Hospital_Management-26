@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Generate Bills";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-file-invoice-dollar me-2"></i>Generate Bills</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">@Model.Message</div>
}

<div class="card shadow">
    <div class="card-body">
        @if (Model.Bills.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Bill ID</th>
                            <th>Patient</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in Model.Bills)
                        {
                            <tr>
                                <td>@bill.BillId</td>
                                <td>@bill.PatientName</td>
                                <td>$@bill.Amount.ToString("N2")</td>
                                <td>@bill.BillDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge @(bill.IsPaid ? "bg-success" : "bg-warning")">
                                        @(bill.IsPaid ? "Paid" : "Unpaid")
                                    </span>
                                </td>
                                <td>
                                    @if (!bill.IsPaid)
                                    {
                                        <form method="post" asp-page-handler="MarkPaid" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@bill.AppointmentId" />
                                            <button type="submit" class="btn btn-sm btn-success me-1">
                                                <i class="fas fa-check me-1"></i>Mark Paid
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="MarkUnpaid" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@bill.AppointmentId" />
                                            <button type="submit" class="btn btn-sm btn-secondary">
                                                <i class="fas fa-times me-1"></i>Mark Unpaid
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">No bills to display.</div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-page="/Doctor/DoctorHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Home
    </a>
</div>
