@page "{appointmentId:int}"
@model ClinicManagement.Web.Pages.Doctor.HistoryUpdateModel
@{
    ViewData["Title"] = "Update History";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-edit me-2"></i>Update Patient History</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">@Model.Message</div>
}

<div class="card shadow">
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
            <div class="mb-3">
                <label class="form-label">Disease / Diagnosis *</label>
                <input type="text" name="disease" class="form-control" value="@Model.Appointment?.Disease" required maxlength="30" />
            </div>
            <div class="mb-3">
                <label class="form-label">Progress *</label>
                <textarea name="progress" class="form-control" rows="3" required maxlength="50">@Model.Appointment?.Progress</textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Prescription *</label>
                <textarea name="prescription" class="form-control" rows="3" required maxlength="60">@Model.Appointment?.Prescription</textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Update
                </button>
                <a asp-page="/Doctor/PatientHistory" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Back
                </a>
            </div>
        </form>
    </div>
</div>
