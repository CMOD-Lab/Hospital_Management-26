@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Previous History";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-history me-2"></i>Previous Patient History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.Appointments.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Patient</th>
                            <th>Date</th>
                            <th>Disease</th>
                            <th>Progress</th>
                            <th>Prescription</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.Appointments)
                        {
                            <tr>
                                <td>@appt.AppointmentId</td>
                                <td>@appt.PatientName</td>
                                <td>@appt.AppointmentDate.ToString("yyyy-MM-dd")</td>
                                <td>@appt.Disease</td>
                                <td>@appt.Progress</td>
                                <td>@appt.Prescription</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">No previous history found.</div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-page="/Doctor/DoctorHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Home
    </a>
</div>
